# Copy this file to `.env.local` for local development, and set the same keys
# as environment variables in your hosting provider for production.
#
# Never commit real values. `.env.local` is gitignored; only this example file
# is tracked.

# ---------------------------------------------------------------------------
# Billing API (required for live pricing)
# ---------------------------------------------------------------------------

# Origin of the IntelliHire billing API. Must be a full http(s) URL.
# The pricing section calls `${BILLING_API_BASE_URL}/api/v1/web/billing/plans`.
# Server-only: never prefixed with NEXT_PUBLIC_, so it is not sent to browsers.
#
#   local dev : http://192.168.1.109:4003
#   production: https://api.intellihire.ai
BILLING_API_BASE_URL=https://api.intellihire.ai

# Sent as the `X-API-Key` header. Leave unset while the plans endpoint is
# public; set it the moment the backend requires authentication.
# Secret: store it in the host's encrypted environment settings, never in git.
# BILLING_API_KEY=

# Origin of the public API, used by the browser for the Contact Sales form
# (POST /api/v1/web/billing/custom-plan-inquiry). That endpoint needs no auth.
# Public by design: this value ships to the browser, so it must be reachable
# from a visitor's machine. Usually the same origin as BILLING_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=https://api.intellihire.ai

# ---------------------------------------------------------------------------
# Site and CTA links (optional)
# ---------------------------------------------------------------------------

# Public site URL, used for canonical links and metadata.
# NEXT_PUBLIC_SITE_URL=https://intellihire.supermia.ai

# Where the pricing CTAs point. The plan code is appended automatically as
# `?plan=<PLAN_CODE>`. Falls back to a mailto link when unset.
# NEXT_PUBLIC_APP_SIGNUP_URL=https://app.intellihire.supermia.ai/signup
# NEXT_PUBLIC_SALES_URL=mailto:hello@supermia.ai?subject=IntelliHire%20custom%20plan
